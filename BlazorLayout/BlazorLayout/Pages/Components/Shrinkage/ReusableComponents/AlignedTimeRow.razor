
<div class="row align-items-center mb-1 flex-nowrap">

    <!-- Label + : -->
    <div class="col-auto" style="min-width: 180px; max-width: 220px;">
        <div class="d-flex justify-content-end">
            <span class="me-1 text-nowrap small">
                @Label
            </span>
            <span style="width: 2px; text-align: center;">:</span>
        </div>
    </div>

    <!-- Input -->
    <div class="col-auto ps-1 pe-1">
        @InputContent
    </div>

    <!-- Optional actions -->
    @if (ActionsContent != null)
    {
        <div class="col-auto d-flex align-items-center small ps-1 pe-0">
            @ActionsContent
        </div>
    }

</div>


@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = default!;

    // Contenu libre pour l'input
    [Parameter, EditorRequired]
    public RenderFragment InputContent { get; set; } = default!;

    // Contenu libre pour ?, boutons, etc. (facultatif)
    [Parameter]
    public RenderFragment? ActionsContent { get; set; }
}

