
@if (Model is not null && !string.IsNullOrWhiteSpace(Model.Id))
{
    <div id="@Model.Id" class="d-none">
        <div class="card shadow-sm" style="max-width: 600px; white-space: nowrap;">
            <div class="card-body p-3">
                @if (!string.IsNullOrWhiteSpace(Model.Title))
                {
                    <h6 class="font-weight-bold mb-2 text-primary">@Model.Title</h6>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="mb-2">@Model.Description</p>
                }

                @if (Model.Items?.Any() == true)
                {
                    <ul class="mb-3 pl-3">
                        @foreach (var item in Model.Items)
                        {
                            <li>@item</li>
                        }
                    </ul>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Warning))
                {
                    <p class="text-danger font-weight-bold mb-0">@((MarkupString)Model.Warning)</p>
                }
            </div>
        </div>
    </div>
}

@code {

    [Parameter, EditorRequired]
    public PopoverCardModel? Model { get; set; }

}
