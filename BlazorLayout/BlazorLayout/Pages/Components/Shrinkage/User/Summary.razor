@using BlazorLayout.Enums
@using BlazorLayout.Pages.Components.Shrinkage.ReusableComponents
@using BlazorLayout.Pages.Components.Shrinkage.ReusableComponents.PopOvers
@using BlazorLayout.Shared
@using BlazorLayout.Utilities
@inherits StatefulComponent<Summary.StateT>


    <div class="row">

    <div class="col-md-6">
        
        <div class="form-group row align-items-center mb-2">
            <label for="team" class="col-5 col-form-label text-end">@Localizer["shrinkage_message_select_team"] :</label>


            <div class="col-7">
                @if (!State.Teams.Any())
                {
                    <div class="text-danger">@Localizer["shrinkage_warning_no_teams"]</div>
                }
                else
                {
                    if (UserShrinkage != null)
                    {
                        <EditForm id="team" Model="UserShrinkage.UserDailyValues">
                            <InputSelect @bind-Value="selectedTeamId"
                                         
                                         class="form-control" style="width: 90% !important;">
                                <option value="@Guid.Empty" disabled>-- @Localizer["shrinkage_message_select_team"] --</option>
                                @foreach (var team in State.Teams.OrderBy(x => x.Name))
                                {
                                    <option @key="team.Id" value="@team.Id">@team.Name</option>
                                }
                            </InputSelect>
                        </EditForm>
                    }
                }
            </div>

            <div class="my-4"></div>



            @* Bezahlen Stunden *@
           <AlignedTimeRow Label="@Localizer["shrinkage_label_paid_time"]">

                        <InputContent>
                               <TimeInput Value="@PaidTime.FormatTimeSpanToHhMm()" ReadOnly="true" />
                        </InputContent>

           </AlignedTimeRow>



            @* Freizeitausgleich *@
            <AlignedTimeRow Label="@Localizer["shrinkage_label_paid_time_off"]">

                <InputContent>
                       <TimeInput Id="paid-time-off"
                                  Placeholder="hh:mm"
                                  Value="@PaidTimeOffInput"
                                  ReadOnly="@(!isEditingPaidTimeOff || IsReadOnly)"
                                  
                                  OnInput="@(e => PaidTimeOffInput = e.Value?.ToString() ?? string.Empty)"
                                  OnBlur="FormatPaidTimeOffOnBlur" />
                </InputContent>

                <ActionsContent>
                  
                   
                    <ButtonPopover Disabled="@( AnySummaryEditing|| IsTimerActive)"
                                   Placement="right"
                                   data-content-id="popover-paid-time-off" />


                    @if (!isEditingPaidTimeOff)
                    {

                        <IconButton OnClick="@StartEditPaid"
                                    ButtonType="button"
                                    Disabled="@(AnySummaryEditing || IsTimerActive)"
                                    CssClass="btn btn-outline-dark btn-sm fixed-btn">
                            @Localizer["shrinkage_button_update"]
                        </IconButton>
                      
                    }
                    else
                    {
                        <IconButton OnClick="@SavePaidTimeOffAsync"
                                    ButtonType="button"
                                    CssClass="btn btn-success btn-sm fixed-btn">
                            @Localizer["shrinkage_button_save"]
                        </IconButton>
                      
                    }
                </ActionsContent>

            </AlignedTimeRow>

            <!-- Overtime -->
           <AlignedTimeRow Label="@Localizer["shrinkage_label_over_time"]">

                <InputContent>
                      <TimeInput Id="overtime"
                               Placeholder="hh:mm"
                               Value="@OvertimeInput"
                               ReadOnly="@(!isEditingOvertime || IsReadOnly)"
                               OnInput="@(e => OvertimeInput = e.Value?.ToString() ?? string.Empty)"
                               OnBlur="FormatOvertimeOnBlur" />
                </InputContent>

                <ActionsContent>
                    

                    <ButtonPopover Disabled="@(IsTimerActive || AnySummaryEditing)"
                                   Placement="right"
                                   data-content-id="popover-overtime" />

                    @if (!isEditingOvertime)
                    {
                        

                        <IconButton OnClick="@StartEditOvertime"
                                    ButtonType="button"
                                    Disabled="@(AnySummaryEditing || IsTimerActive)"
                                    CssClass="btn btn-outline-dark btn-sm fixed-btn">
                            @Localizer["shrinkage_button_update"]
                        </IconButton>
                      

                    }
                    else
                    {
                        <IconButton OnClick="@SaveOvertimeAsync"
                                    ButtonType="button"
                                    
                                    CssClass="btn btn-success btn-sm fixed-btn">
                            @Localizer["shrinkage_button_save"]
                        </IconButton>
                    }
                </ActionsContent>

            </AlignedTimeRow> 

            <!-- Urlaub -->
            <AlignedTimeRow Label="@Localizer["shrinkage_label_vacation"]">

                <InputContent>
                    <TimeInput Id="vacation-time"
                               Placeholder="hh:mm"
                               Value="@VacationTimeInput"
                               ReadOnly="@(!isEditingVacationTime || IsReadOnly)"
                               OnInput="@(e => VacationTimeInput = e.Value?.ToString() ?? string.Empty)"
                               OnBlur="FormatVacationTimeOnBlur" />
                </InputContent>

                <ActionsContent>


                    <ButtonPopover 
                                   Placement="right"
                                   Disabled="@(AnySummaryEditing || IsTimerActive)"
                                   data-content-id="popover-vacation_time" />

                    @if (!isEditingVacationTime)
                    {
                        <IconButton OnClick="@StartEditVacationTime"
                                    ButtonType="button"
                                    Disabled="@(AnySummaryEditing || IsTimerActive)"
                                    CssClass="btn btn-outline-dark btn-sm fixed-btn">
                            @Localizer["shrinkage_button_update"]
                        </IconButton>
                    }
                    else
                    {
                        <IconButton OnClick="@SaveVacationTimeAsync"
                                    ButtonType="button"
                                    
                                    CssClass="btn btn-success btn-sm fixed-btn">
                            @Localizer["shrinkage_button_save"]
                        </IconButton>
                    }
                </ActionsContent>

            </AlignedTimeRow>

            <div class="my-4"></div>

            <!-- Differents Activities -->
            @foreach (ActivityTypeDto type in Enum.GetValues(typeof(ActivityTypeDto))
                        .Cast<ActivityTypeDto>()
                        .Where(a => a != ActivityTypeDto.Unspecified))
            {
                var title = type.GetPopOverTitle();
                var popoverId = "popover-" + title;

                var runningForType = Activities.FirstOrDefault(a => a.ActivityType == type && a.StoppedAt == null);
                var isTimerRunning = runningForType is not null;

                string duration;

                if (isTimerRunning)
                {
                    var elapsed = (TimerService.IsRunning && activeActivityType == type)
                    ? TimerService.Elapsed
                    : DateTime.Now - runningForType!.StartedAt;

                    duration = TimeFormatter.FormatTimeSpanToHhMmSs(elapsed);
                }
                else
                {
                    var teamId = State!.CurrentUser!.TeamId;
                    duration = teamId.HasValue
                    ? TimeCalculator.GetTotalDurationOfActivity(Activities, type, teamId.Value)
                    : "00:00";
                }

           
                <AlignedTimeRow Label="@type.ConvertToActivityTypeString()">

                    <InputContent>
                        <TimeInput Value="@duration"
                                   ReadOnly="true"
                                   CssClass="@(isTimerRunning ? "fw-bold" : "")" />
                    </InputContent>

                    <ActionsContent>

                        <ButtonPopover 
                                       Placement="right"
                                       Disabled="@(AnySummaryEditing || IsTimerActive)"
                                       data-content-id="@popoverId" />

                        @if (!isTimerRunning)
                        {
                            <IconButton OnClick="async () => await StartTimer(type)"
                                        ButtonType="button"
                                        Disabled="@(AnySummaryEditing || IsReadOnly || IsTimerActive)"
                                        CssClass="btn btn-outline-success btn-sm fixed-btn">
                                @Localizer["shrinkage_button_start"]
                            </IconButton>
                        }
                        else
                        {
                            <IconButton OnClick="async () => await StopTimer()"
                                        ButtonType="button"
                                        Disabled="@(AnySummaryEditing || IsReadOnly)"
                                        CssClass="btn btn-success btn-sm fixed-btn">
                                @Localizer["shrinkage_button_stop"]
                            </IconButton>
                        }

                    </ActionsContent>

                </AlignedTimeRow>
            }


        </div>

    </div>

    </div>




    <PopOverContent/>